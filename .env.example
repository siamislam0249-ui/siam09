# Database connection string (Vercel Postgres, Neon, Supabase, or any Postgres URL)
POSTGRES_URL=postgres://user:password@host:5432/dbname

# Secret used to sign login sessions - use a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Only used locally when running: npm run seed-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password-here
