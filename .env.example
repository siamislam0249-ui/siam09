# MongoDB Atlas connection string (from Atlas dashboard: Connect -> Drivers)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional - database name (defaults to "lunchpoll" if omitted)
MONGODB_DB=lunchpoll

# Secret used to sign login sessions - use a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Only used locally when running: npm run seed-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password-here
